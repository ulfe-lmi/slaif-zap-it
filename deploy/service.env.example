# Copy this file to a private operator location such as
# ~/.config/slaif-zap-it/service.env, chmod 600, and source it before starting
# scripts/serve_local.sh. Never commit the private copy or an API key.

# Re-verify with nvidia-smi immediately before each activation.
# The launcher requires this operator-owned physical index explicitly. The
# historical maelstrom1 qualification used index 1; the 2026-08-24 hinton2
# assignment uses index 0. Set the UUID for the same card.
SLAIF_ZAP_IT_PHYSICAL_GPU_INDEX=1
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=1
SLAIF_ZAP_IT_EXPECTED_GPU_UUID=GPU-REPLACE_WITH_LIVE_GPU_UUID
SLAIF_ZAP_IT_HOST=127.0.0.1
# Leave empty to select 17891, then 23654, then a verified free fallback.
SLAIF_ZAP_IT_PORT=
SLAIF_ZAP_IT_TMP_ROOT=/dev/shm/slaif-zap-it
# Operator cache containing all approved pinned snapshots; no download is
# attempted by the live service. Use an absolute, private operator path.
SLAIF_ZAP_IT_MODEL_CACHE_ROOT=
# Residency and supported profiles are selected automatically from fresh,
# UUID-matched physical GPU total capacity; do not override them here.
SLAIF_ZAP_IT_STRICT_GPU=1

# Frozen service limits (override only as an operator decision).
SLAIF_ZAP_IT_MAX_IMAGE_UPLOAD_BYTES=20971520
SLAIF_ZAP_IT_MAX_CONFIG_UPLOAD_BYTES=262144
SLAIF_ZAP_IT_MAX_DECODED_PIXELS=64000000
SLAIF_ZAP_IT_MAX_RESPONSE_BYTES=268435456
SLAIF_ZAP_IT_MAX_IMAGE_WIDTH=8192
SLAIF_ZAP_IT_MAX_IMAGE_HEIGHT=8192
SLAIF_ZAP_IT_MAX_OBJECTS=256
SLAIF_ZAP_IT_MAX_VISUALIZATION_STREAMS=8
SLAIF_ZAP_IT_MAX_RESPONSE_ARTIFACTS=64
SLAIF_ZAP_IT_MAX_DEBUG_ARTIFACTS=48
SLAIF_ZAP_IT_MAX_SINGLE_ARTIFACT_BYTES=33554432
SLAIF_ZAP_IT_MAX_TOTAL_RAW_ARTIFACT_BYTES=134217728
SLAIF_ZAP_IT_MAX_MASK_RLE_RUNS_PER_OBJECT=250000
SLAIF_ZAP_IT_MAX_MASK_RLE_RUNS_TOTAL=1000000
SLAIF_ZAP_IT_MIN_HOST_AVAILABLE_BYTES=2147483648
SLAIF_ZAP_IT_MIN_SHM_FREE_BYTES=67108864
SLAIF_ZAP_IT_REQUEST_DEADLINE_SECONDS=120
SLAIF_ZAP_IT_QUEUE_DEPTH=0
SLAIF_ZAP_IT_RETRY_AFTER_SECONDS=5

# Optional loopback bearer key. Keep unset for the default loopback-only mode.
# SLAIF_ZAP_IT_API_KEY=

# Explicit fixed-model management is disabled by default. To enable it, set a
# private, distinct bearer key and retain the loopback-only service boundary.
SLAIF_ZAP_IT_MODEL_CONTROL_MODE=none
# SLAIF_ZAP_IT_MODEL_CONTROL_API_KEY=
SLAIF_ZAP_IT_MODEL_CONTROL_DRAIN_SECONDS=120
SLAIF_ZAP_IT_MODEL_CONTROL_OPERATION_SECONDS=600
