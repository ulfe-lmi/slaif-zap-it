# OPTIONAL user-level systemd template for the SLAIF ZAP-IT loopback service.
#
# This unit file is SHIPPED UNINSTALLED. Tests never require it. Installing it
# is a deliberate human action:
#
#   cp deploy/zap-it-local.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now zap-it-local.service
#   journalctl --user -u zap-it-local.service -f
#
# Before enabling, live-verify the GPU UUID and port (docs/RUNBOOK.md). The
# private EnvironmentFile must be mode 0600 and the installed-venv executable
# below must be replaced with the operator's reviewed candidate path.

[Unit]
Description=SLAIF ZAP-IT loopback service (operator-pinned GPU, explicit lifecycle optional)
Documentation=https://github.com/ulfe-lmi/slaif-zap-it/blob/main/docs/RUNBOOK.md

[Service]
Type=simple
EnvironmentFile=%h/.config/slaif-zap-it/service.env
# Installed foreground entrypoint placeholder; do not enable until reviewed.
ExecStart=/usr/bin/env %h/.local/share/venvs/zap-it-0.1.0/bin/zap-it-service
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
# The repo-owned launcher remains supported: scripts/serve_local.sh start.

[Install]
WantedBy=default.target
